}

model Visitor {
  id            String             @id @default(uuid()) @db.Uuid
  name          String             @db.VarChar(255)
  phone         String             @unique @db.VarChar(20)
  email         String?            @db.VarChar(255)
  idProofType   IdProofType        @map("id_proof_type")
  idProofNumber String             @map("id_proof_number") @db.VarChar(100)
  address       String?
  photoUrl      String?            @map("photo_url")
  status        VisitorStatus      @default(ACTIVE)
  createdById   String             @map("created_by") @db.Uuid
  createdAt     DateTime           @default(now()) @map("created_at")
  updatedAt     DateTime           @updatedAt @map("updated_at")
  deletedAt     DateTime?          @map("deleted_at")
  visitRequests VisitRequest[]
  changeLogs    VisitorChangeLog[]
  createdBy     Parent             @relation(fields: [createdById], references: [id])

  @@index([phone])
  @@index([status])
  @@map("visitors")
}

model VisitorChangeLog {
  id              String    @id @default(uuid()) @db.Uuid
  visitorId       String    @map("visitor_id") @db.Uuid
  action          String    @db.VarChar(50)
  performedById   String    @map("performed_by") @db.Uuid
  performedByRole String    @map("performed_by_role") @db.VarChar(20)
  reason          String?
  timestamp       DateTime?
  visitor         Visitor   @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  @@index([visitorId])
  @@map("visitor_change_logs")
}

model VisitRequest {
  id           String             @id @default(uuid()) @db.Uuid
  visitorId    String             @map("visitor_id") @db.Uuid
  parentId     String?            @map("parent_id") @db.Uuid
  studentId    String             @map("student_id") @db.Uuid
  relationship String             @db.VarChar(50)
  purpose      String             @db.VarChar(255)
  status       VisitRequestStatus @default(PENDING)
  remarks      String?
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")
  parent       Parent?            @relation(fields: [parentId], references: [id])
  student      Student            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  visitor      Visitor            @relation(fields: [visitorId], references: [id], onDelete: Cascade)

  @@index([visitorId])
  @@index([studentId])
  @@index([status])
  @@map("visit_requests")
}

model VisitorVisit {
  id               String                @id @default(uuid()) @db.Uuid
  visitorRefId     String                @map("visitor_ref_id") @db.Uuid
  visitorRefType   String                @map("visitor_ref_type") @db.VarChar(20)
  hostelId         String                @map("hostel_id") @db.Uuid
